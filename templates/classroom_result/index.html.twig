{% extends 'base.html.twig' %}

{% block title %}Résultats des élèves - Google Classroom{% endblock %}

{% block stylesheets %}
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
{% endblock %}

{% block body %}
    <div data-controller="mask" data-mask-target="container">
    <header class="classroom-header">
        <div class="header-left">
            <span class="material-icons-outlined" style="color: var(--classroom-primary); font-size: 28px;">school</span>
            <div class="course-info">
                <h1 class="course-name">{{ course_name }}</h1>
                <div class="course-period">
                    {% if current_trimester %}
                        {{ current_trimester == 'T1' ? 'Trimestre 1' : (current_trimester == 'T2' ? 'Trimestre 2' : 'Trimestre 3') }}
                    {% else %}
                        Période personnalisée
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="header-actions">
            <label class="m3-switch" title="Masquer les noms et les notes pour une projection">
                <input type="checkbox" role="switch" aria-checked="false" data-action="change->mask#toggle" id="mask-switch">
                <span class="m3-switch-track">
                    <span class="m3-switch-thumb"></span>
                </span>
                <span class="m3-switch-label" for="mask-switch">Mode projection</span>
            </label>
        </div>
    </header>

    <main class="main-container">
        {% for message in app.flashes('error') %}
            <div class="flash flash-error">
                <span class="material-icons-outlined">error_outline</span>
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="flash flash-success">
                <span class="material-icons-outlined">check_circle_outline</span>
                {{ message }}
            </div>
        {% endfor %}

        <div class="classroom-card">
            <form method="get">
                <div class="filter-bar">
                    <div class="filter-item">
                        <label for="trimester" class="filter-label">Période :</label>
                        <select name="trimester" id="trimester" class="classroom-select" onchange="this.form.submit()">
                            <option value="" {{ current_trimester is empty ? 'selected' : '' }}>Toutes les périodes</option>
                            <option value="T1" {{ current_trimester == 'T1' ? 'selected' : '' }}>Trimestre 1</option>
                            <option value="T2" {{ current_trimester == 'T2' ? 'selected' : '' }}>Trimestre 2</option>
                            <option value="T3" {{ current_trimester == 'T3' ? 'selected' : '' }}>Trimestre 3</option>
                        </select>
                    </div>

                    <div class="filter-item">
                        <label for="sort" class="filter-label">Trier par :</label>
                        <select name="sort" id="sort" class="classroom-select" onchange="this.form.submit()">
                            <option value="none" {{ current_sort == 'none' ? 'selected' : '' }}>Ordre alphabétique</option>
                            <option value="desc" {{ current_sort == 'desc' ? 'selected' : '' }}>Moyenne la plus haute</option>
                            <option value="asc" {{ current_sort == 'asc' ? 'selected' : '' }}>Moyenne la plus basse</option>
                        </select>
                    </div>

                    {% if current_trimester or start_date or end_date or current_sort != 'none' %}
                        <a href="{{ path('app_classroom_results') }}" class="md-button-text md-button" style="padding: 4px 8px; font-size: 0.75rem;">
                            Réinitialiser
                        </a>
                    {% endif %}
                </div>
            </form>

            <div class="table-wrapper">
                <div class="is-masked-overlay">Mode projection activé</div>
                <table aria-label="Tableau des résultats des élèves">
                    <thead>
                        <tr>
                            <th scope="col">Élève</th>
                            <th scope="col">Moyenne <span class="scale-info">/20</span></th>
                            {% for topic, scale in topic_scales %}
                                <th scope="col">{{ topic }} <span class="scale-info">/{{ scale }}</span></th>
                            {% endfor %}
                            <th scope="col" style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in results %}
                            {% set result = item.result %}
                            <tr>
                                <td>
                                    <div class="student-name-cell">
                                        <div class="student-avatar">{{ result.studentName|slice(0, 1)|upper }}</div>
                                        <span class="student-name">{{ result.studentName|capitalize }}</span>
                                    </div>
                                </td>
                                <td>
                                    {% if result.globalAverage is defined and result.globalAverage is not null %}
                                        <span class="average-badge">{{ result.globalAverage|number_format(2, ',', ' ') }}</span>
                                    {% else %}
                                        <span class="empty-cell">Non évalué</span>
                                    {% endif %}
                                </td>

                                {% for topic, scale in topic_scales %}
                                    <td class="grade-cell">
                                        {% set found = false %}
                                        {% for subject in result.subjects %}
                                            {% if subject.subjectName == topic %}
                                                {{ subject.average|number_format(2, ',', ' ') }}
                                                {% set found = true %}
                                            {% endif %}
                                        {% endfor %}

                                        {% if not found %}
                                            <span class="empty-cell">-</span>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                                <td style="text-align: right;">
                                    <div style="display: inline-flex; gap: 8px;">
                                        <button type="button"
                                                class="md-button-text md-button open-appreciation-modal"
                                                data-id="{{ item.id }}"
                                                data-student="{{ result.studentName|capitalize }}"
                                                data-average="{{ result.globalAverage|number_format(2, ',', ' ') }}"
                                                data-appreciation="{{ item.appreciation }}"
                                                title="Ajouter une appréciation">
                                            <span class="material-icons-outlined action-icon">comment</span>
                                        </button>

                                        {% if item.googleDocBulletinLink %}
                                            <a href="{{ item.googleDocBulletinLink }}" target="_blank" rel="noopener noreferrer" class="md-button-text md-button" title="Ouvrir le bulletin">
                                                <span class="material-icons-outlined action-icon">open_in_new</span>
                                            </a>
                                            {% set delete_params = app.request.query.all|merge({id: item.id}) %}
                                            <form action="{{ path('app_classroom_result_bulletin_delete', delete_params) }}" method="post" class="delete-bulletin-form">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-bulletin-' ~ item.id) }}">
                                                <button type="submit" class="md-button-text md-button" title="Supprimer le bulletin" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce bulletin ?');">
                                                    <span class="material-icons-outlined" style="color: #d93025;">delete</span>
                                                </button>
                                            </form>
                                        {% elseif item.appreciation is not empty %}
                                            {% set bulletin_params = app.request.query.all|merge({id: item.id}) %}
                                            <a href="{{ path('app_classroom_result_bulletin', bulletin_params) }}"
                                               class="md-button-text md-button generate-bulletin-btn"
                                               data-student="{{ result.studentName|capitalize }}"
                                               title="Générer le bulletin">
                                                <span class="material-icons-outlined" style="color: var(--classroom-primary);">description</span>
                                            </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ topic_scales|length + 3 }}" style="text-align: center; padding: 48px; color: var(--classroom-text-secondary);">
                                    <span class="material-icons-outlined" style="font-size: 48px; display: block; margin-bottom: 16px;">info</span>
                                    Aucun résultat disponible pour cette période.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="footer">
            <span>&copy; 2026 Google Classroom Average Calculator</span>
            <span>&bull;</span>
            <a href="https://github.com/sfinx13/google-classroom-average-calculator" target="_blank" rel="noopener noreferrer">
                GitHub
            </a>
        </footer>
    </main>
    </div>
    <!-- Modal Appréciation -->
    <div id="appreciationModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Appréciation de l'enseignant</h2>
            </div>
            <form id="appreciationForm" method="post">
                <input type="hidden" name="_token" id="appreciation_token">
                <div class="modal-body">
                    <div class="student-info-row">
                        <div class="student-info-item">
                            <label>Élève</label>
                            <span id="modalStudentName">-</span>
                        </div>
                        <div class="student-info-item">
                            <label>Moyenne générale</label>
                            <span id="modalStudentAverage">-</span>
                        </div>
                    </div>
                    <div class="textarea-group">
                        <textarea name="appreciation" id="appreciationTextarea" class="md-textarea" placeholder="Saisissez vos commentaires sur la progression de l'élève..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="md-button close-modal">Annuler</button>
                    <button type="submit" class="md-button md-button-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        (function() {
            function disableAllButtons() {
                const allActionButtons = document.querySelectorAll('.md-button');
                allActionButtons.forEach(btn => {
                    if (btn.tagName === 'A') {
                        btn.style.pointerEvents = 'none';
                        btn.style.opacity = '0.6';
                    } else {
                        btn.disabled = true;
                    }
                });
            }

            function resetUI() {
                const allActionButtons = document.querySelectorAll('.md-button');
                allActionButtons.forEach(btn => {
                    if (btn.tagName === 'A') {
                        btn.style.pointerEvents = 'auto';
                        btn.style.opacity = '1';
                    } else {
                        btn.disabled = false;
                    }
                });
            }

            document.addEventListener('click', function(e) {
                const modal = document.getElementById('appreciationModal');
                if (!modal) return;

                const openBtn = e.target.closest('.open-appreciation-modal');
                if (openBtn) {
                    const id = openBtn.getAttribute('data-id');
                    const student = openBtn.getAttribute('data-student');
                    const average = openBtn.getAttribute('data-average');
                    const appreciation = openBtn.getAttribute('data-appreciation');

                    document.getElementById('modalStudentName').textContent = student;
                    document.getElementById('modalStudentAverage').textContent = average + ' / 20';
                    document.getElementById('appreciationTextarea').value = appreciation;

                    if (window.appCsrfTokens && window.appCsrfTokens[id]) {
                        document.getElementById('appreciation_token').value = window.appCsrfTokens[id];
                    }

                    const form = document.getElementById('appreciationForm');
                    const currentUrl = new URL(window.location.href);
                    const searchParams = currentUrl.searchParams;
                    let actionUrl = "{{ path('app_classroom_result_appreciation', {'id': 'PLACEHOLDER'}) }}".replace('PLACEHOLDER', id);

                    if (searchParams.toString()) {
                        actionUrl += '?' + searchParams.toString();
                    }

                    form.action = actionUrl;
                    modal.style.display = 'flex';
                }

                if (e.target.closest('.close-modal') || e.target === modal) {
                    modal.style.display = 'none';
                }

                if (e.target.closest('.generate-bulletin-btn')) {
                    disableAllButtons();
                }
            });

            document.addEventListener('submit', function(e) {
                const deleteForm = e.target.closest('.delete-bulletin-form');
                const appreciationForm = e.target.closest('#appreciationForm');

                if (deleteForm || appreciationForm) {
                    disableAllButtons();
                    if (appreciationForm) {
                        const submitBtn = appreciationForm.querySelector('button[type="submit"]');
                        if (submitBtn) {
                            submitBtn.textContent = 'Enregistrement...';
                        }
                    }
                }
            });

            document.addEventListener('turbo:load', function() {
                window.appCsrfTokens = {
                    {% for item in results %}
                        "{{ item.id }}": "{{ csrf_token('save-appreciation-' ~ item.id) }}",
                    {% endfor %}
                };
                resetUI();
            });
        })();
    </script>
{% endblock %}
